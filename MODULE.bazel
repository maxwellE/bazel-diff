module(
    name = "bazel-diff",
    version = "49.1.0",
    # rules_rs (the Rust ruleset) uses the Starlark `set` type, which Bazel 7
    # does not have.
    bazel_compatibility = [">=8.0.0"],
    compatibility_level = 0,
)

bazel_dep(name = "aspect_rules_lint", version = "2.1.0", dev_dependency = True)
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.2", dev_dependency = True)
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5", dev_dependency = True)

# Direct dep because //release selects on @platforms//os and @platforms//cpu to
# name the release binaries.
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_license", version = "1.0.0")

# protoc for the build script that compiles rust/proto/*.proto into the crate.
bazel_dep(name = "protobuf", version = "33.4")

# rules_python is only needed when building bazel-diff itself (the release,
# coverage and e2e tooling under //tools is Python). Marked dev_dependency so
# consumers of bazel-diff as a module don't inherit it via MVS.
bazel_dep(name = "rules_python", version = "1.8.4", dev_dependency = True)

# Go support is internal to building/testing bazel-diff (tooling under tools/go,
# whose line coverage is gated at >=90% in CI). Marked dev_dependency so consumers
# of bazel-diff as a module don't inherit rules_go/gazelle via MVS.
bazel_dep(name = "rules_go", version = "0.62.0", dev_dependency = True)
bazel_dep(name = "gazelle", version = "0.51.3", dev_dependency = True)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk", dev_dependency = True)
go_sdk.download(version = "1.23.1")

# Rust is a first-class published implementation (`//:bazel-diff-rust`) and is
# also used by the LCOV merger under //tools/coverage. Kept as a non-dev
# dependency so BCR consumers and top-level verify_targets can build the Rust
# binary without --ignore_dev_dependency stripping the crate repos/toolchains.
#
# rules_rs redistributes rules_rust's compilation rules (as a patched
# @rules_rust repository, exposed below) and replaces its toolchain and
# crate_universe extensions: toolchains are hermetic downloads that cover every
# target triple from each exec host, and crates resolve straight from
# Cargo.lock with no Bazel-specific lockfile.
bazel_dep(name = "rules_rs", version = "0.0.112")

# Direct dep only for the Windows ABI constraint //platforms:local_windows_msvc
# sets; already in the graph through rules_rs.
bazel_dep(name = "llvm", version = "0.8.18")

# The rules_rust repository rules_rs builds on. Exposed as @rules_rust for the
# pieces rules_rs does not wrap: the clippy/rustfmt aspects and test rules,
# rust settings flags in .bazelrc, and the upstream rustfmt wrapper.
rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")

# rustfmt defaults to the same release as the toolchain (rather than a
# nightly), so the `rustfmt_aspect` gate in .bazelrc checks formatting with the
# exact rustfmt a contributor gets from `cargo fmt` on a stable toolchain.
#
# One toolchain per exec host, each able to target every supported triple --
# including the x86_64/aarch64 musl targets the Linux release binaries are
# built for (see //platforms), which rules_rs tells apart from glibc with its
# own libc constraint. No per-target `repository_set` plumbing is needed.
#
# Named `rs` rather than rules_rs's default `default_rust_toolchains` because
# the name is part of every stdlib path on Windows, where MSVC's link.exe is
# MAX_PATH-bound (see `release-artifacts` in .github/workflows/ci.yaml): the
# longer name alone pushes the bootstrap toolchain's
# librustc_std_workspace_alloc-<hash>.rlib past 260 characters.
toolchains.toolchain(
    name = "rs",
    edition = "2021",
    version = "1.90.0",
)

# Toolchain pinned to `rust-version` in Cargo.toml, so the MSRV job in ci.yaml
# can prove the crate still builds on the minimum Rust it advertises. Keep the
# version in sync with `rust-version` in Cargo.toml.
#
# A separate repository that is deliberately not registered below, so it never
# takes part in ordinary toolchain resolution. The MSRV job selects it
# explicitly with --extra_toolchains, which outranks every registered toolchain.
toolchains.toolchain(
    name = "rust_msrv",
    edition = "2021",
    version = "1.85.0",
)
use_repo(toolchains, "rs", "rust_msrv")

register_toolchains("@rs//...")

# C toolchain for the musl target: a gcc cross-compiler bundled with musl libc,
# used to link the Rust binary and to build the C in `ring` (rustls). Scoped to
# musl platforms (see //platforms) so it never displaces the host cc toolchain on ordinary
# builds. dev_dependency because only bazel-diff's own release build needs it --
# consumers of the module never resolve it.
bazel_dep(name = "toolchains_musl", version = "0.1.27.bcr.1", dev_dependency = True)

toolchains_musl = use_extension(
    "@toolchains_musl//:toolchains_musl.bzl",
    "toolchains_musl",
    dev_dependency = True,
)
toolchains_musl.config(extra_target_compatible_with = ["@rules_rs//rs/platforms/constraints:musl"])

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "bazel_diff_crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    # Every exec and target triple that can take part in a build: the CI and
    # release hosts, plus the musl targets of the Linux release binaries (whose
    # build scripts and proc-macros still run on the glibc exec triples).
    platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "aarch64-unknown-linux-musl",
        "x86_64-apple-darwin",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu",
        "x86_64-unknown-linux-musl",
    ],
)
use_repo(crate, "bazel_diff_crates")
